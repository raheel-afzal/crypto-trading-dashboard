# Any Postgres works: Render, Neon, Supabase or a local instance.
# Hosted databases usually need SSL, e.g. ...?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/crypto_trading"

# Signing key for access tokens. Leave unset and the server generates one per process.
# JWT_SECRET="replace-me"

# A throwaway database for `npm test` - the suite wipes it between tests.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/crypto_trading_test"
